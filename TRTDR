rooms = {
    "A": "Dirty",
    "B": "Dirty"
}

current_room = "A"

for i in range(4):

    print("\nCurrent Room:", current_room)
    print("Room Status:", rooms[current_room])

    if rooms[current_room] == "Dirty":
        print("Action: Suck")
        rooms[current_room] = "Clean"

    else:
        print("Action: Move")
        
        if current_room == "A":
            current_room = "B"
        else:
            current_room = "A"

print("\nFinal Room Status:")
print(rooms)
